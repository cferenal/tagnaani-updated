{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Person or business the farmer deals with"
    },
    "role": {
      "type": "string",
      "enum": [
        "seed_supplier",
        "fertilizer_supplier",
        "pesticide_supplier",
        "buyer",
        "technician",
        "labor",
        "transport",
        "other"
      ],
      "enumColors": [
        "green",
        "yellow",
        "purple",
        "blue",
        "pink",
        "gray",
        "red",
        "green"
      ],
      "default": "seed_supplier",
      "description": "How this person is connected to the farm"
    },
    "organization": {
      "type": "string",
      "description": "Business, cooperative or group"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "City or municipality"
    },
    "supplies": {
      "type": "string",
      "description": "What they supply or buy, e.g. certified seeds"
    },
    "notes": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Known and vouched for by the farmer"
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}