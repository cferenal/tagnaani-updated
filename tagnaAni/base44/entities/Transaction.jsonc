{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "expense",
        "revenue"
      ],
      "enumColors": [
        "red",
        "green"
      ],
      "description": "Money out or money in"
    },
    "category": {
      "type": "string",
      "description": "Fertilizer, seeds, labor, sales..."
    },
    "amount": {
      "type": "number",
      "description": "Amount in PHP"
    },
    "crop": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}