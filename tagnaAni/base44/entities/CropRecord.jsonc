{
  "name": "CropRecord",
  "type": "object",
  "properties": {
    "crop": {
      "type": "string",
      "description": "Crop grown in this cycle"
    },
    "planted_seeds": {
      "type": "number"
    },
    "current_crop_count": {
      "type": "number"
    },
    "stored_seeds": {
      "type": "number"
    },
    "harvest_kg": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "crop"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}